{
  "id": "gitee",
  "name": "Gitee",
  "description": "管理 Gitee 仓库、文件、Issue 与 PR。安装后填入私人令牌。",
  "transport": "streamable-http",
  "url": "https://api.gitee.com/mcp",
  "authType": "bearer",
